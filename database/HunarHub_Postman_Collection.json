    {
      "name": "7. Customer Inquiries",
      "item": [
        {
          "name": "POST Submit Public Inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tariq Mehmood\",\n  \"email\": \"tariq@example.com\",\n  \"phone\": \"+92 300 1122334\",\n  \"subject\": \"Custom Bridal Shawl Order Inquiry\",\n  \"message\": \"I would like to order a custom embroidered Doch shawl for an upcoming family wedding.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/messages", "host": ["{{baseUrl}}"], "path": ["messages"] }
          }
        },
        {
          "name": "GET All Messages (Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/messages", "host": ["{{baseUrl}}"], "path": ["messages"] }
          }
        },
        {
          "name": "PUT Mark Message Read (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
