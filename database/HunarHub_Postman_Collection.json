{
  "info": {
    "_postman_id": "balochhunar-api-collection-2026",
    "name": "BalochHunar — Digital Artisan & Handicraft Business Platform API",
    "description": "Comprehensive Postman collection for testing BalochHunar REST APIs (Authentication, Artisans, Categories, Products, Services, Gallery, Messages, and AI Intelligence).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "POST Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@balochhunar.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET Current User (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "GET Dashboard Statistics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/stats", "host": ["{{baseUrl}}"], "path": ["auth", "stats"] }
          }
        },
        {
          "name": "POST Admin Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Categories CRUD",
      "item": [
        {
          "name": "GET All Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "POST Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Handcarved Wooden Crafts\",\n  \"description\": \"Heritage rosewood and walnut carvings from regional artisans.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
          }
        },
        {
          "name": "PUT Update Category (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Handcarved Wooden Crafts & Decor\",\n  \"description\": \"Updated description for wood carvings.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories/1", "host": ["{{baseUrl}}"], "path": ["categories", "1"] }
          }
        },
        {
          "name": "DELETE Category (Admin)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/categories/5", "host": ["{{baseUrl}}"], "path": ["categories", "5"] }
          }
        }
      ]
    },
    {
      "name": "3. Master Artisans CRUD",
      "item": [
        {
          "name": "GET All Artisans",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/artisans", "host": ["{{baseUrl}}"], "path": ["artisans"] }
          }
        },
        {
          "name": "GET Single Artisan Details",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/artisans/1", "host": ["{{baseUrl}}"], "path": ["artisans", "1"] }
          }
        },
        {
          "name": "POST Create Artisan (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bibi Shahnaz\",\n  \"location\": \"Turbat, Balochistan\",\n  \"experience_years\": 18,\n  \"craft_type\": \"Balochi Hand Embroidery\",\n  \"bio\": \"Specializes in microscopic Kaputuk stitch patterns.\",\n  \"image_url\": \"https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=600\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/artisans", "host": ["{{baseUrl}}"], "path": ["artisans"] }
          }
        }
      ]
    },
    {
      "name": "4. Products Catalog & Multi-Search",
      "item": [
        {
          "name": "GET All Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "GET Products Multi-Search & Filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=doch&category=1&min_price=5000&sort=price_desc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "doch" },
                { "key": "category", "value": "1" },
                { "key": "min_price", "value": "5000" },
                { "key": "sort", "value": "price_desc" }
              ]
            }
          }
        },
        {
          "name": "GET Single Product",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/1", "host": ["{{baseUrl}}"], "path": ["products", "1"] }
          }
        },
        {
          "name": "POST Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Embroidered Velvet Bridal Shawl\",\n  \"category_id\": 1,\n  \"artisan_id\": 1,\n  \"price\": 22500,\n  \"tags\": \"Balochi, Doch, Velvet, Bridal, Heirloom\",\n  \"description\": \"A masterpiece of traditional silk needlework on pure velvet.\",\n  \"is_featured\": true,\n  \"image_url\": \"https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?w=800\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        }
      ]
    },
